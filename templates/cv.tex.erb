<% document = data.fetch('document') -%>
<% profile = data.fetch('profile') -%>
<% footer = data.fetch('footer') -%>
<% sections = data.fetch('sections') -%>
%!TEX TS-program = xelatex
%!TEX encoding = UTF-8 Unicode
%% Generated from data/cv.yaml via scripts/render_cv.rb. Do not edit directly.

\documentclass[<%= document.fetch('class_options') %>]{<%= document.fetch('class_name') %>}

\name{<%= profile.fetch('name_left') %>}{<%= profile.fetch('name_right') %>}
\position{<%= profile.fetch('position') %>}
\address{<%= profile.fetch('address') %>}
\mobile{<%= profile.fetch('mobile') %>}
\email{<%= profile.fetch('email') %>}
\homepage{<%= profile.fetch('homepage') %>}
\github{<%= profile.fetch('github') %>}
<% if profile['version_stamp'] -%>
\cvversion{<%= profile.fetch('version_stamp') %>}
<% end -%>

\begin{document}
\makecvheader
\makecvfooter
  {<%= footer.fetch('left') %>}
  {<%= footer.fetch('center') %>}
  {<%= footer.fetch('right') %>}

\urlstyle{same}

%%================================================================
%% Page 1 — Atelier 5/7 hero. Sidebar carries identity (Contact,
%% Education at a glance, Credentials). Main column opens with
%% Professional Experience and the current-role header. After page
%% 1, paracol ends and the rest of the doc runs full-width.
%% Sidebar fill (eso-pic) is disabled on pages 2+ via the class.
%%================================================================

\begin{atelierbody}

%%-------- Sidebar (5/12 column, page 1 only) --------

\cvsidesection{Contact}
\begin{cvsidehonors}
  \item\relax
  {\fontsize{9.5}{14}\InterTightRegular\color{atelierText}%
    <%= profile.fetch('address') %>\\[1mm]
    <%= profile.fetch('mobile') %>\\[0.5mm]
    \href{mailto:<%= profile.fetch('email') %>}{<%= profile.fetch('email') %>}\\[0.5mm]
    \href{https://<%= profile.fetch('homepage') %>}{<%= profile.fetch('homepage') %>}\\[0.5mm]
    \href{https://github.com/<%= profile.fetch('github') %>}{github.com/<%= profile.fetch('github') %>}}
\end{cvsidehonors}

\cvsidesection{Education}
\begin{cvsidehonors}
<% sections.fetch('education').each do |entry| -%>
  \cvsidehonor
    {<%= entry.fetch('degree') %>}
    {<%= entry.fetch('institution') %>}
    {<%= entry.fetch('location') %>}
    {<%= entry.fetch('dates') %>}
<% end -%>
\end{cvsidehonors}

\cvsidesection{Credentials}
\begin{cvsidehonors}
<% sections.fetch('credentials').each do |entry| -%>
  \cvsidecredential{<%= entry.fetch('credential') %>}
<% end -%>
\end{cvsidehonors}

\tomain

%%-------- Main (7/12 column, page 1 only) — Professional Experience opens --------

<% pro_exp = sections.fetch('professional_experience') -%>
<% first = pro_exp.first -%>
<%
  # Split the AACI Admin body into hero (page-1 paracol) and continuation
  # (full-width on page 2+). First 5 bullets fit in the narrow paracol
  # main column on page 1; an explicit \newpage after \end{atelierbody}
  # ensures bullet 6 starts cleanly at full width on page 2 instead of
  # bleeding across the paracol/single-col boundary at bottom of page 1.
  body_lines = first.fetch('body_tex').split("\n")
  item_lines = body_lines.select { |l| l.strip.start_with?('\item') }
  hero_n = 5
  hero_items = item_lines.first(hero_n)
  rest_items = item_lines.drop(hero_n)
-%>

\cvsection{Professional Experience}
\begin{cventries}
  \cvheroentry
    {<%= first.fetch('title') %>}
    {<%= first.fetch('organization') %>}
    {<%= first.fetch('location') %>}
    {<%= first.fetch('dates') %>}
    {
      \begin{cvitems}
<% hero_items.each do |item| -%>
<%= item %>
<% end -%>
      \end{cvitems}
    }
\end{cventries}

\end{atelierbody}

%% Force a clean break so the remaining AACI Admin bullets start at the
%% top of page 2 at full width — otherwise bullet 6 would bleed across
%% the paracol/single-col boundary at the bottom of page 1.
\newpage

%%================================================================
%% After paracol ends + page break, remaining AACI bullets continue
%% at full width on page 2, then the rest of Professional Experience.
%% Sidebar eso-pic fill is gated on page 1 only.
%%================================================================

<% if rest_items.any? -%>
\begin{cvitems}
<% rest_items.each do |item| -%>
<%= item %>
<% end -%>
\end{cvitems}
<% end -%>

%% Remaining roles
\begin{cventries}
<% pro_exp.drop(1).each do |entry| -%>
  \cventry
    {<%= entry.fetch('title') %>}
    {<%= entry.fetch('organization') %>}
    {<%= entry.fetch('location') %>}
    {<%= entry.fetch('dates') %>}
<% body = entry.fetch('body_tex', '').to_s.strip -%>
<% if body.empty? -%>
    {}
<% else -%>
    {
<%= entry.fetch('body_tex') %>
    }
<% end -%>

<% end -%>
\end{cventries}

\newpage
\cvsection{Selected Professional Work}
<% sections.fetch('publications').each do |subsection| -%>
\cvsubsection{<%= subsection.fetch('title') %>}
<% if subsection.key?('scope_note') -%>

\par\vspace{1mm}
{\fontsize{9}{12}\InterTightRegular\itshape\color{muted} <%= subsection.fetch('scope_note') %>}
\par\vspace{2mm}
<% end -%>
\begin{pubitems}
<% subsection.fetch('items').each do |item| -%>
  \item {<%= item %>}
<% end -%>
\end{pubitems}

<% end -%>

\newpage
\cvsection{Selected Presentations \& Teaching}
\begin{cventries}
<% sections.fetch('presentations').each do |entry| -%>
  \cventry
    {<%= entry.fetch('role') %>}
    {<%= entry.fetch('event') %>}
    {<%= entry.fetch('location') %>}
    {<%= entry.fetch('dates') %>}
    {
<% items = entry.fetch('items', []) -%>
<% if items.any? -%>
      \begin{cvitems}
<% items.each do |item| -%>
        \item {<%= item %>}
<% end -%>
      \end{cvitems}
<% end -%>
    }

<% end -%>
\end{cventries}

\cvsection{Honors \& Awards}
\begin{cvhonors}
<% sections.fetch('honors').each do |entry| -%>
  \cvhonor
    {<%= entry.fetch('award') %>}
    {<%= entry.fetch('event') %>}
    {<%= entry.fetch('location') %>}
    {<%= entry.fetch('dates') %>}
<% end -%>
\end{cvhonors}

\cvsection{Professional \& Civic Service}
\begin{cvhonors}
<% sections.fetch('professional_service').each do |entry| -%>
  \cvhonor
    {<%= entry.fetch('position') %>}
    {<%= entry.fetch('committee') %>}
    {<%= entry.fetch('location') %>}
    {<%= entry.fetch('dates') %>}
<% end -%>
\end{cvhonors}

\end{document}
